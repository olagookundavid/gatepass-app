# Environment for orders-api. Generated from contracts/orders-api.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.

# REQUIRED: Region for every SDK client
AWS_REGION=us-east-1
# optional: SDK retry attempts (1-10), default 3
#AWS_MAX_ATTEMPTS=3
# optional: debug|info|warn|error
#LOG_LEVEL=info
# optional: Public listener, default :8080
#HTTP_ADDR=:8080
# optional: Public route prefix, default /orders; the Ingress does not strip it
#BASE_PATH=/orders
# optional: Wait after SIGTERM before draining, default 5s
#SHUTDOWN_DELAY=5s
# optional: OTLP/HTTP collector; no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# optional: Service name in telemetry
#OTEL_SERVICE_NAME=orders-api
# optional: Extra resource attributes
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# REQUIRED: Expected iss claim
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# REQUIRED: Expected client_id claim of access tokens
COGNITO_CLIENT_ID=<app-client-id>
# REQUIRED: RDS PostgreSQL endpoint host name (must match the TLS certificate)
DB_HOST=<rds-endpoint>
# optional: Default 5432
#DB_PORT=5432
# REQUIRED: Database name
DB_NAME=orders
# REQUIRED: Secrets Manager secret holding JSON {username,password} (orders_app; the migrate Job uses the orders_migrator secret). The VALUE is never in Git or env
DB_SECRET_ID=<secret-name-or-arn>
# optional: pgxpool max connections, default 10
#DB_MAX_CONNS=10
# optional: Server-side statement_timeout, default 5s
#DB_STATEMENT_TIMEOUT=5s
# optional: Override the embedded RDS CA bundle (normally unset)
#DB_SSL_ROOT_CERT=/etc/ssl/rds/global-bundle.pem
# REQUIRED: Cluster-internal URL of the reservations INTERNAL listener (no trailing path)
RESERVATIONS_INTERNAL_URL=http://reservations-internal.gatepass.svc.cluster.local:8081
# REQUIRED: Payments queue (with DLQ, maxReceiveCount 5)
PAYMENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/orders-payments
