# Environment for lambda-nightly-report. Generated from contracts/lambda-nightly-report.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.

# REQUIRED: RDS endpoint host name of the orders database (must match the TLS certificate)
DB_HOST=<rds-endpoint>
# optional: Default 5432
#DB_PORT=5432
# REQUIRED: Orders database name
DB_NAME=orders
# REQUIRED: Read-only database user created WITH rds_iam
DB_USER=orders_report
# REQUIRED: S3 bucket for reports/YYYY/MM/DD.csv
REPORTS_BUCKET=<reports-bucket>
# REQUIRED: Set by the Lambda runtime
AWS_REGION=us-east-1
# optional: debug|info|warn|error
#LOG_LEVEL=info
