# Environment for skeleton-api. Generated from contracts/skeleton-api.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.
# Every variable is optional: the binary starts with an empty environment.

# optional: debug|info|warn|error
#LOG_LEVEL=info
# optional: Public listener, default :8080
#HTTP_ADDR=:8080
# optional: Public route prefix, default /skeleton. The three routes are also served at the root, which is what the kubelet probes
#BASE_PATH=/skeleton
# optional: Wait after SIGTERM before draining, default 5s
#SHUTDOWN_DELAY=5s
# optional: true makes /readyz answer 503 (the pipeline's "a broken image is not promoted" proof). /livez stays 200
#FORCE_NOT_READY=false
# optional: OTLP/HTTP collector; telemetry is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# optional: Service name in traces/metrics
#OTEL_SERVICE_NAME=skeleton-api
# optional: Extra resource attributes
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
