# Environment for catalog-api. Generated from contracts/catalog-api.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.

# REQUIRED: Region for every SDK client
AWS_REGION=us-east-1
# optional: SDK retry attempts (1-10), default 3
#AWS_MAX_ATTEMPTS=3
# optional: debug|info|warn|error
#LOG_LEVEL=info
# optional: Public listener, default :8080
#HTTP_ADDR=:8080
# optional: Public route prefix, default /catalog; the Ingress does not strip it
#BASE_PATH=/catalog
# optional: Wait after SIGTERM before draining, default 5s
#SHUTDOWN_DELAY=5s
# optional: OTLP/HTTP collector; telemetry is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# optional: Service name in traces/metrics
#OTEL_SERVICE_NAME=catalog-api
# optional: Extra resource attributes
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# REQUIRED: Expected iss claim; JWKS is fetched from <issuer>/.well-known/jwks.json
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# REQUIRED: Expected client_id claim of access tokens
COGNITO_CLIENT_ID=<app-client-id>
# REQUIRED: RDS PostgreSQL endpoint host name (must match the TLS certificate)
DB_HOST=<rds-endpoint>
# optional: Default 5432
#DB_PORT=5432
# REQUIRED: Database name
DB_NAME=catalog
# REQUIRED: Database user created WITH rds_iam; the migrate Job uses catalog_migrator
DB_USER=catalog_app
# REQUIRED: Must be true; the service has no password path
DB_IAM_AUTH=true
# optional: pgxpool max connections, default 10. replicas x this must stay below the RDS max_connections
#DB_MAX_CONNS=10
# optional: Server-side statement_timeout, default 5s
#DB_STATEMENT_TIMEOUT=5s
# optional: Override the embedded RDS CA bundle (normally unset)
#DB_SSL_ROOT_CERT=/etc/ssl/rds/global-bundle.pem
# REQUIRED: ElastiCache primary endpoint host:port (TLS)
REDIS_ADDR=<elasticache-endpoint>:6379
# optional: Redis ACL user (IAM-enabled user when REDIS_IAM_AUTH=true)
#REDIS_USER=catalog
# optional: Use an IAM token as the Redis password
#REDIS_IAM_AUTH=true
# optional: ElastiCache replication group / serverless cache name; required when REDIS_IAM_AUTH=true
#CACHE_NAME=<cache-name>
# optional: true for ElastiCache Serverless (changes the IAM token request)
#REDIS_SERVERLESS=false
# optional (secret: path of a mounted file): Fallback: file holding a Redis AUTH password (when IAM auth is off)
#REDIS_AUTH_FILE=/var/run/secrets/redis/password
# REQUIRED: S3 bucket receiving event images
IMAGES_BUCKET=<images-bucket>
# REQUIRED: CloudFront base URL serving the images bucket
CDN_BASE_URL=https://cdn.example.com
# REQUIRED: EventBridge bus for EventPublished
EVENT_BUS_NAME=gatepass-dev
