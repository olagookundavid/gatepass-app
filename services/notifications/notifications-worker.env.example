# Environment for notifications-worker. Generated from contracts/notifications-worker.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.

# REQUIRED: Region for every SDK client
AWS_REGION=us-east-1
# optional: SDK retry attempts (1-10), default 3
#AWS_MAX_ATTEMPTS=3
# optional: debug|info|warn|error
#LOG_LEVEL=info
# optional: Probe listener, default :8080
#HTTP_ADDR=:8080
# optional: Wait after SIGTERM before draining, default 5s
#SHUTDOWN_DELAY=5s
# optional: OTLP/HTTP collector; no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# optional: Service name in telemetry
#OTEL_SERVICE_NAME=notifications-worker
# optional: Extra resource attributes
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# REQUIRED: DynamoDB table (PK, SK; TTL attribute ttl; no GSI)
TABLE_NAME=<notifications-table>
# REQUIRED: Private S3 bucket for tickets/<userId>/<orderId>.png
TICKETS_BUCKET=<tickets-bucket>
# REQUIRED: Queue fed by EventBridge rules; DLQ with maxReceiveCount 5; visibility timeout >= 60s
NOTIFICATIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/notifications
# REQUIRED: Pool used for AdminGetUser (username = user id / sub)
COGNITO_USER_POOL_ID=<user-pool-id>
# REQUIRED: Verified SES sender identity
SES_FROM_ADDRESS=tickets@example.com
# optional: SES configuration set (bounce/complaint events)
#SES_CONFIGURATION_SET=gatepass
# optional: Send EVERY e-mail to this one address (sandbox helper)
#EMAIL_RECIPIENT_OVERRIDE=success@simulator.amazonses.com
# REQUIRED (secret: path of a mounted file): File with the HMAC key for QR tokens (>= 32 chars)
TICKET_SIGNING_KEY_FILE=/var/run/secrets/ticket/signing-key
# optional: Requested validity of the e-mailed link, 1m-168h, default 24h (effective validity is capped by the signing credentials' lifetime)
#TICKET_LINK_TTL=24h
# optional: Concurrent messages per pod, 1-64, default 4
#WORKER_CONCURRENCY=4
# optional: Visibility timeout set per receive (extended by a heartbeat), default 60s
#CONSUMER_VISIBILITY_TIMEOUT=60s
