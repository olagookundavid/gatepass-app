# Environment for lambda-hold-expirer. Generated from contracts/lambda-hold-expirer.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.

# REQUIRED: Same DynamoDB table as reservations-api
TABLE_NAME=<reservations-table>
# REQUIRED: Set by the Lambda runtime
AWS_REGION=us-east-1
# optional: debug|info|warn|error
#LOG_LEVEL=info
# optional: SDK retry attempts
#AWS_MAX_ATTEMPTS=3
