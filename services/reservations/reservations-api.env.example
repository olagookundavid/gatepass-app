# Environment for reservations-api. Generated from contracts/reservations-api.yaml; values are PLACEHOLDERS.
# Never put real secrets here: secret=yes variables point at mounted files.

# REQUIRED: Region for every SDK client
AWS_REGION=us-east-1
# optional: SDK retry attempts (1-10), default 3
#AWS_MAX_ATTEMPTS=3
# optional: debug|info|warn|error
#LOG_LEVEL=info
# optional: Public listener, default :8080
#HTTP_ADDR=:8080
# optional: Internal listener (consume endpoint), default :8081; only started when API_ENABLED=true
#INTERNAL_HTTP_ADDR=:8081
# optional: Public route prefix, default /reservations
#BASE_PATH=/reservations
# optional: Wait after SIGTERM before draining, default 5s
#SHUTDOWN_DELAY=5s
# optional: OTLP/HTTP collector; no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# optional: Service name in telemetry
#OTEL_SERVICE_NAME=reservations-api
# optional: Extra resource attributes
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# REQUIRED: DynamoDB table (PK, SK, GSI1 on GSI1PK/GSI1SK, TTL attribute ttl)
TABLE_NAME=<reservations-table>
# optional: Serve the public and internal APIs, default true
#API_ENABLED=true
# optional: Run the inventory SQS consumer, default false
#CONSUMER_ENABLED=false
# optional: Required when CONSUMER_ENABLED=true
#INVENTORY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/reservations-inventory
# optional: Concurrent message handlers, default 4
#CONSUMER_WORKERS=4
# optional: SQS visibility timeout set while handling (extended by a heartbeat), default 60s
#CONSUMER_VISIBILITY_TIMEOUT=60s
# optional: Required when API_ENABLED=true
#COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# optional: Required when API_ENABLED=true
#COGNITO_CLIENT_ID=<app-client-id>
# optional: EventBridge Scheduler group holding hold-<id> schedules; required when API_ENABLED=true
#SCHEDULER_GROUP_NAME=gatepass-holds
# optional: Role Scheduler assumes to invoke the Lambda; reservations-api needs iam:PassRole on it; required when API_ENABLED=true
#SCHEDULER_ROLE_ARN=arn:aws:iam::<account-id>:role/gatepass-scheduler-invoke-expirer
# optional: Schedule target; required when API_ENABLED=true
#EXPIRER_LAMBDA_ARN=arn:aws:lambda:us-east-1:<account-id>:function:gatepass-hold-expirer
# optional: How long a hold lasts, 1m-1h, default 10m
#HOLD_TTL=10m
# optional: POST /holds per user per minute, default 10
#RATE_LIMIT_PER_MINUTE=10
# optional: ElastiCache host:port (TLS); required when API_ENABLED=true
#REDIS_ADDR=<elasticache-endpoint>:6379
# optional: Redis ACL user
#REDIS_USER=reservations
# optional: Use an IAM token as the Redis password
#REDIS_IAM_AUTH=true
# optional: ElastiCache name for the IAM token; required when REDIS_IAM_AUTH=true
#CACHE_NAME=<cache-name>
# optional: true for ElastiCache Serverless
#REDIS_SERVERLESS=false
# optional (secret: path of a mounted file): Fallback AUTH password file
#REDIS_AUTH_FILE=/var/run/secrets/redis/password
